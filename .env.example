# Auth.js / Google OAuth
AUTH_SECRET=generate-a-random-32-byte-secret
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3123
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_AUTH_ENABLED=true

# Only this email receives owner access to Blog Admin and Inventory management.
OWNER_EMAIL=you@example.com

# Production uses AUTH_URL=https://me.mukhtada.my.id and requires this exact
# Google callback: https://me.mukhtada.my.id/api/auth/callback/google

DB_PASSWORD=your-database-password

# Server-only backend shard router. Keep all values below out of NEXT_PUBLIC_
# unless the name explicitly says PUBLISHABLE_KEY.
SUPABASE_BACKEND_APP_KEY=generate-a-long-random-server-only-key
SUPABASE_BACKEND_BUCKET=mb-backend-assets

SUPABASE_SHARD_1_ID=s1
SUPABASE_SHARD_1_PROJECT_REF=project-ref-1
SUPABASE_SHARD_1_URL=https://project-ref-1.supabase.co
SUPABASE_SHARD_1_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SHARD_1_DB_HOST=db.project-ref-1.supabase.co
SUPABASE_SHARD_1_STORAGE_ENDPOINT=https://project-ref-1.storage.supabase.co/storage/v1/s3
SUPABASE_SHARD_1_STORAGE_REGION=ap-southeast-2
SUPABASE_SHARD_1_STORAGE_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_SHARD_1_STORAGE_SECRET_ACCESS_KEY=your-s3-secret-access-key

SUPABASE_SHARD_2_ID=s2
SUPABASE_SHARD_2_PROJECT_REF=project-ref-2
SUPABASE_SHARD_2_URL=https://project-ref-2.supabase.co
SUPABASE_SHARD_2_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SHARD_2_DB_HOST=db.project-ref-2.supabase.co
SUPABASE_SHARD_2_STORAGE_ENDPOINT=https://project-ref-2.storage.supabase.co/storage/v1/s3
SUPABASE_SHARD_2_STORAGE_REGION=ap-northeast-1
SUPABASE_SHARD_2_STORAGE_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_SHARD_2_STORAGE_SECRET_ACCESS_KEY=your-s3-secret-access-key

SUPABASE_SHARD_3_ID=s3
SUPABASE_SHARD_3_PROJECT_REF=project-ref-3
SUPABASE_SHARD_3_URL=https://project-ref-3.supabase.co
SUPABASE_SHARD_3_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SHARD_3_DB_HOST=db.project-ref-3.supabase.co
SUPABASE_SHARD_3_STORAGE_ENDPOINT=https://project-ref-3.storage.supabase.co/storage/v1/s3
SUPABASE_SHARD_3_STORAGE_REGION=ap-northeast-1
SUPABASE_SHARD_3_STORAGE_ACCESS_KEY_ID=your-s3-access-key-id
SUPABASE_SHARD_3_STORAGE_SECRET_ACCESS_KEY=your-s3-secret-access-key
