# Auth.js / Google OAuth
AUTH_SECRET=generate-a-random-32-byte-secret
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3123
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_AUTH_ENABLED=true

# Owner access is deliberately pinned in auth.js to
# mukhtadanasution@gmail.com; it is not deployment-configurable.

# Production uses AUTH_URL=https://me.mukhtada.my.id and requires this exact
# Google callback: https://me.mukhtada.my.id/api/auth/callback/google

# Convex deployment URLs. Keep the cloud and HTTP Actions origins distinct.
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_CLOUD_URL=https://your-deployment.convex.cloud
CONVEX_HTTP_URL=https://your-deployment.convex.site

# Shared only by Next.js server code and the Convex deployment. Generate and
# synchronize it with `npm run convex:bridge:configure`; never expose it as
# NEXT_PUBLIC_.
CONVEX_INTERNAL_API_KEY=generate-a-long-random-server-only-key

# Optional compatibility guard for direct backend API clients.
BACKEND_API_KEY=generate-a-long-random-server-only-key

# Nala calls OpenRouter only from server code. Conversation persistence remains
# disabled; the owner-managed runtime settings live in Convex.
NALA_KEY=your-openrouter-api-key
NALA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Public SEO and ownership verification. These values render in browser HTML,
# but keeping deployment-specific values in env avoids duplicating them in code.
NEXT_PUBLIC_SITE_URL=https://me.mukhtada.my.id
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
AHREFS_SITE_VERIFICATION=

# Optional server-only key for the PageSpeed Insights CLI.
PAGESPEED_INSIGHT_API=your-pagespeed-insights-api-key

# Server-only IndexNow ownership key. Never prefix this with NEXT_PUBLIC_.
# The app verifies it at /indexnow-key.txt and includes that URL as keyLocation.
AHREFS_INDEXNOW_KEY=generate-an-indexnow-key
